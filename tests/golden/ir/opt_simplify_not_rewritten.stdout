global @x
global @y

entry:
  %0 = load @x
  %1 = load @y
  %2 = const 0
  %3 = const -1
  %4 = const 1
  %5 = div %0, %0
  %6 = div %2, %0
  %7 = div %0, %3
  %8 = div %0, %2
  %9 = sub %4, %0
  %10 = sub %0, %4
  %11 = add %0, %4
  %12 = const 2
  %13 = mul %0, %12
  %14 = eq %0, %1
  %15 = add %2, %2
  %16 = div %2, %2
  exit %0
