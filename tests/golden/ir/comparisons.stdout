global @r0
global @a
global @b

entry:
  %0 = load @a
  %1 = load @b
  %2 = lt %0, %1
  store @r0, %2
  %3 = load @a
  %4 = load @b
  %5 = le %3, %4
  store @r0, %5
  %6 = load @a
  %7 = load @b
  %8 = gt %6, %7
  store @r0, %8
  %9 = load @a
  %10 = load @b
  %11 = ge %9, %10
  store @r0, %11
  %12 = load @a
  %13 = load @b
  %14 = eq %12, %13
  store @r0, %14
  %15 = load @a
  %16 = load @b
  %17 = ne %15, %16
  store @r0, %17
  %18 = load @r0
  exit %18
