; spec: §8.7 fold: every value opcode with known operands becomes const,
; computed by ir_eval_* (wraparound: INT64_MAX + 1 = INT64_MIN, §5.7).
entry:
  %0 = const 9223372036854775807
  %1 = const 1
  %2 = add %0, %1
  %3 = const -9223372036854775808
  %4 = sub %3, %1
  %5 = mul %0, %0
  %6 = const 7
  %7 = const -2
  %8 = div %6, %7
  %9 = and %6, %7
  %10 = or %6, %7
  %11 = neg %3
  %12 = not %6
  %13 = eq %6, %6
  %14 = ne %6, %7
  %15 = lt %7, %6
  %16 = le %6, %7
  %17 = gt %6, %7
  %18 = ge %7, %6
  %19 = copy %8
  %20 = add %19, %2
  exit %20
