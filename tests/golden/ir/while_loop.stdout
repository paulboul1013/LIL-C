global @i
global @r0

entry:
  jmp while.cond.1

while.cond.1:
  %0 = load @i
  %1 = const 10
  %2 = lt %0, %1
  br %2, while.body.1, while.end.1

while.body.1:
  %3 = load @i
  %4 = const 1
  %5 = add %3, %4
  store @i, %5
  jmp while.cond.1

while.end.1:
  %6 = load @i
  store @r0, %6
  %7 = load @r0
  exit %7
