global @i
global @j
global @r0

entry:
  jmp while.cond.1

while.cond.1:
  %0 = load @i
  %1 = const 3
  %2 = lt %0, %1
  br %2, while.body.1, while.end.1

while.body.1:
  %3 = const 0
  store @j, %3
  jmp do.body.2

do.body.2:
  %4 = load @j
  %5 = const 1
  %6 = add %4, %5
  store @j, %6
  %7 = load @j
  %8 = const 2
  %9 = eq %7, %8
  br %9, if.then.3, if.end.3

if.then.3:
  jmp do.end.2

dead.4:
  jmp if.end.3

if.end.3:
  jmp do.cond.2

do.cond.2:
  %10 = load @j
  %11 = const 5
  %12 = lt %10, %11
  br %12, do.body.2, do.end.2

do.end.2:
  %13 = load @i
  %14 = const 1
  %15 = add %13, %14
  store @i, %15
  %16 = load @i
  %17 = const 1
  %18 = eq %16, %17
  br %18, if.then.5, if.end.5

if.then.5:
  jmp while.cond.1

dead.6:
  jmp if.end.5

if.end.5:
  jmp while.cond.1

while.end.1:
  %19 = load @i
  %20 = load @j
  %21 = add %19, %20
  store @r0, %21
  %22 = load @r0
  exit %22
