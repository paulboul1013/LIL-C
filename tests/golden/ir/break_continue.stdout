global @i
global @r0

entry:
  jmp while.cond.1

while.cond.1:
  %0 = load @i
  %1 = const 10
  %2 = lt %0, %1
  br %2, while.body.1, while.end.1

while.body.1:
  %3 = load @i
  %4 = const 1
  %5 = add %3, %4
  store @i, %5
  %6 = load @i
  %7 = const 3
  %8 = eq %6, %7
  br %8, if.then.2, if.end.2

if.then.2:
  jmp while.cond.1

dead.3:
  jmp if.end.2

if.end.2:
  %9 = load @i
  %10 = const 7
  %11 = eq %9, %10
  br %11, if.then.4, if.end.4

if.then.4:
  jmp while.end.1

dead.5:
  jmp if.end.4

if.end.4:
  %12 = const 48
  %13 = load @i
  %14 = add %12, %13
  putc %14
  jmp while.cond.1

while.end.1:
  %15 = load @i
  store @r0, %15
  %16 = load @r0
  exit %16
