; spec: §8.4 rule 4: %1 is defined on both paths into join (accepted);
; an unreachable cycle that no root reaches is not checked.
entry:
  %0 = const 1
  br %0, then, else
then:
  %1 = const 2
  jmp join
else:
  %1 = const 3
  jmp join
join:
  exit %1
cycle.a:
  putc %9
  jmp cycle.b
cycle.b:
  %9 = const 4
  jmp cycle.a
