; spec: §8.7 simplify: the algebraic identities, with the constant on
; either side of commutative opcodes; x is unknown (a load).
global @x

entry:
  %0 = load @x
  %1 = const 0
  %2 = const 1
  %3 = const -1
  %4 = add %0, %1
  %5 = add %1, %0
  %6 = sub %0, %1
  %7 = sub %1, %0
  %8 = sub %0, %0
  %9 = mul %0, %1
  %10 = mul %2, %0
  %11 = mul %0, %3
  %12 = mul %1, %0
  %13 = div %0, %2
  %14 = and %0, %1
  %15 = and %3, %0
  %16 = and %0, %0
  %17 = or %0, %1
  %18 = or %0, %3
  %19 = or %0, %0
  %20 = eq %0, %0
  %21 = ne %0, %0
  %22 = lt %0, %0
  %23 = le %0, %0
  %24 = gt %0, %0
  %25 = ge %0, %0
  %26 = or %1, %0
  %27 = or %3, %0
  %28 = and %1, %0
  %29 = mul %3, %0
  %30 = and %0, %3
  exit %4
