global @i
global @r0

entry:
  jmp while.cond.1

while.cond.1:
  %0 = load @i
  %1 = const 3
  %2 = lt %0, %1
  %3 = const 0
  br %2, and.rhs.2, and.end.2

and.rhs.2:
  %4 = const 120
  putc %4
  %5 = const 0
  %3 = ne %4, %5
  jmp and.end.2

and.end.2:
  br %3, while.body.1, while.end.1

while.body.1:
  %6 = load @i
  %7 = const 1
  %8 = add %6, %7
  store @i, %8
  jmp while.cond.1

while.end.1:
  %9 = load @i
  store @r0, %9
  %10 = load @r0
  exit %10
