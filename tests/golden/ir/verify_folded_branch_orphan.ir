; spec: §8.4 rule 4, §8.7: `r0 = 7 + (0 && b);` after folding the constant br
; into a jmp; and.rhs.1 is left without predecessors and is not checked.
global @r0
global @b

entry:
  %0 = const 7
  %1 = const 0
  %2 = const 0
  jmp and.end.1

and.rhs.1:
  %3 = load @b
  %4 = const 0
  %2 = ne %3, %4
  jmp and.end.1

and.end.1:
  %5 = add %0, %2
  store @r0, %5
  %6 = load @r0
  exit %6
